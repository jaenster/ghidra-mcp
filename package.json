{
  "name": "ghidra-mcp",
  "version": "1.0.0",
  "description": "Headless Ghidra MCP server with SSE/HTTP transport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "bin": {
    "ghidra": "./packages/cli/dist/bin.js"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "pnpm -r --if-present test",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=180000 --import tsx 'test/e2e/**/*.test.ts'",
    "test:e2e:debug": "DEBUG=1 node --test --test-concurrency=1 --test-timeout=180000 --import tsx 'test/e2e/**/*.test.ts'",
    "lint": "eslint packages/*/src/**/*.ts",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p packages/mcp/tsconfig.json --noEmit && tsc -p packages/daemon/tsconfig.json --noEmit && tsc -p packages/cli/tsconfig.json --noEmit",
    "typecheck:all": "tsc --build",
    "start": "pnpm --filter @ghidra-mcp/cli start",
    "dev": "pnpm --filter @ghidra-mcp/daemon dev",
    "fixtures:build": "cd test-fixtures && make native",
    "fixtures:cross": "cd test-fixtures && make cross",
    "fixtures:ghidra": "cd test-fixtures && make ghidra-setup",
    "fixtures:clean": "cd test-fixtures && make distclean",
    "fixtures:verify": "cd test-fixtures && make verify",
    "install:ghidra": "./scripts/install-ghidra.sh",
    "install:worker": "cd ghidra-worker && ./gradlew build",
    "setup": "npm run install:ghidra && npm run install:worker && npm run fixtures:build",
    "ci": "./scripts/ci.sh",
    "ci:quick": "./scripts/ci.sh --skip-e2e"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaenster/ghidra-mcp"
  },
  "license": "MIT"
}
