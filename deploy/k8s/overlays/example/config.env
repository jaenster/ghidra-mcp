# Non-secret per-instance config, consumed via envFrom (configMapGenerator).
# Secrets (auth secret, OIDC client secret, Ghidra Server password, worker secret)
# are created out-of-band — see deploy/k8s/README.md.

# --- Public identity / OAuth ---
# Must match the Ingress host exactly: it is the OAuth issuer and resource identifier.
GHIDRA_MCP_PUBLIC_URL=https://ghidra-mcp.example.com
GHIDRA_MCP_OAUTH_SCOPES=ghidra
# Long-lived access tokens so clients rarely need to refresh (7d).
GHIDRA_MCP_ACCESS_TTL=604800

# --- Federated login (optional, OIDC) ---
# When set, /authorize is redirected to this OIDC provider and only allow-listed users
# get tokens. The client SECRET goes in the ghidra-mcp-auth secret, not here.
GHIDRA_MCP_OIDC_ISSUER=https://id.example.com/application/o/ghidra-mcp/
GHIDRA_MCP_OIDC_CLIENT_ID=replace-with-your-oidc-client-id
GHIDRA_MCP_OIDC_ALLOWED_USERS=your-username

# --- Shared Ghidra Server the daemon connects to ---
# Clients name programs repository-first ("MyRepo/path/to/binary"); the daemon supplies
# this host:port. CREDENTIALS live in the ghidra-mcp-server secret, not here.
GHIDRA_SERVER_HOST=ghidra.example.com
GHIDRA_SERVER_PORT=13100

# --- Worker backend: the daemon spawns ONE pod per worker ---
# With backend=k8s the daemon creates a Ghidra worker pod per session (RBAC in
# base/rbac.yaml lets it), and those pods connect BACK to the daemon over the
# in-cluster Service. Worker pods inherit the daemon pod's image, hostAliases,
# affinity and imagePullSecrets (the launcher reads the daemon's own pod spec).
GHIDRA_MCP_WORKER_BACKEND=k8s
# In-cluster Service URL the worker pods call back to (ghidra-mcp Service :80 -> 8432).
# Form: http://<service>.<namespace>.svc.cluster.local
GHIDRA_MCP_WORKER_DAEMON_URL=http://ghidra-mcp.ghidra-mcp.svc.cluster.local
# Worker JVM heap. The launcher sizes each worker pod's memory LIMIT at this heap +
# ~512Mi native headroom, so worst-case node RAM ~ MAX_WORKERS × (heap + 512Mi).
GHIDRA_MCP_MEMORY=3072m
# Concurrency cap on simultaneous worker pods — bounded by cluster capacity, not by
# the daemon pod's RAM (each worker is its own pod with its own cgroup limit).
GHIDRA_MCP_MAX_WORKERS=6
